// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/miniconda
{
	"name": "Haystack Fast API",
	"dockerComposeFile": "docker-compose.yml",
	"service": "haystack-fast-api",
	"workspaceFolder": "/workspaces/haystack-fast-api",
	"shutdownAction": "stopCompose",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Local Haystack Postgres is published on host 5434 (see docker-compose.yml).
	"forwardPorts": [5434],

	// Use 'postCreateCommand' to run commands after the container is created (rebuild/create only, not every start).
	"postCreateCommand": "sudo chown -R vscode:vscode /workspaces/haystack-fast-api && curl -LsSf https://astral.sh/uv/install.sh | sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-ossdata.vscode-pgsql"
			],
			"settings": {
				"pgsql.connections": [
					{
						"profileName": "Haystack Local (R/W)",
						"host": "db",
						"port": 5432,
						"database": "heavy_rental",
						"user": "postgres",
						"password": "postgres",
						"authenticationType": "SqlLogin",
						"savePassword": true
					},
					{
						"profileName": "REST API Primary (source)",
						"host": "postgres-primary",
						"port": 5432,
						"database": "heavy_rental",
						"user": "postgres",
						"password": "postgres",
						"authenticationType": "SqlLogin",
						"savePassword": true
					}
				]
			}
		}
	},

	// assign non-root user
	"remoteUser": "vscode"
}
